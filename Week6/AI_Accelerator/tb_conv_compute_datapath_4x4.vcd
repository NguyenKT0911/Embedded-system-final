$var reg 8 }$ read_data [7:0] $end
$var reg 32 ~$ stored_count [31:0] $end
$upscope $end
$scope task check1 $end
$var reg 1 !% expected $end
$var reg 1 "% got $end
$var reg 640 #% name [639:0] $end
$upscope $end
$scope task check32 $end
$var reg 32 $% expected [31:0] $end
$var reg 32 %% got [31:0] $end
$var reg 640 &% name [639:0] $end
$upscope $end
$scope task check32s $end
$var reg 32 '% expected [31:0] $end
$var reg 32 (% got [31:0] $end
$var reg 640 )% name [639:0] $end
$upscope $end
$scope task check4 $end
$var reg 4 *% expected [3:0] $end
$var reg 4 +% got [3:0] $end
$var reg 640 ,% name [639:0] $end
$upscope $end
$scope task clear_accumulators $end
$upscope $end
$scope task pulse_start_step $end
$upscope $end
$scope task run_conv_step $end
$var reg 8 -% kh_value [7:0] $end
$var reg 8 .% kw_value [7:0] $end
$upscope $end
$scope task wait_for_pe_accumulate $end
$upscope $end
$scope task wait_for_step_done $end
$upscope $end
$scope task write_input_word $end
$var reg 32 /% data [31:0] $end
$upscope $end
$scope task write_weight_word $end
$var reg 32 0% data [31:0] $end
$upscope $end
$upscope $end
$enddefinitions $end
$comment Show the parameter values. $end
